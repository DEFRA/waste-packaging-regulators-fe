# AI review of the branch being pushed, following .agents/skills/pr-review.
# Stops the push on Blocking findings; fails open if no agent is available or
# the review does not complete. Skip with SKIP_PR_REVIEW=1 or --no-verify.
#
# Choose the agent (env var wins over git config):
#   PR_REVIEW_AGENT / git config pr-review.agent      claude | codex | gemini
#   PR_REVIEW_CMD   / git config pr-review.command    any command; the prompt
#                                                     is passed as its last argument
# With neither set, the first of claude, codex, gemini on PATH is used.

if [ "$SKIP_PR_REVIEW" = "1" ]; then
  echo "pre-push: SKIP_PR_REVIEW=1, skipping AI review"
  exit 0
fi

zero_sha=0000000000000000000000000000000000000000
local_sha=""

# git passes "<local ref> <local sha> <remote ref> <remote sha>" per pushed ref
while read -r _local_ref sha _remote_ref _remote_sha; do
  if [ "$sha" != "$zero_sha" ]; then
    local_sha=$sha
    break
  fi
done

[ -z "$local_sha" ] && exit 0

# husky runs hooks with `sh -e`, so any command allowed to fail needs `|| ...`
git fetch origin main --quiet 2>/dev/null || true
range="origin/main...$local_sha"

if git diff --quiet "$range"; then
  exit 0
fi

agent=${PR_REVIEW_AGENT:-$(git config --get pr-review.agent || true)}
command=${PR_REVIEW_CMD:-$(git config --get pr-review.command || true)}

if [ -z "$command" ] && [ -z "$agent" ]; then
  for candidate in claude codex gemini; do
    if command -v "$candidate" >/dev/null 2>&1; then
      agent=$candidate
      break
    fi
  done
fi

if [ -z "$command" ]; then
  case "$agent" in
    claude)
      command='claude -p --allowedTools "Read,Glob,Grep,Bash(git diff:*),Bash(git log:*),Bash(git show:*)"'
      ;;
    codex)
      command='codex exec --sandbox read-only'
      ;;
    gemini)
      command='gemini --allowed-tools "run_shell_command(git)" -p'
      ;;
    "")
      echo "pre-push: no AI agent found, skipping review (set PR_REVIEW_AGENT or PR_REVIEW_CMD)"
      exit 0
      ;;
    *)
      echo "pre-push: unknown PR_REVIEW_AGENT '$agent', skipping review (use PR_REVIEW_CMD for other agents)"
      exit 0
      ;;
  esac
fi

prompt="Review the changes in git range $range by following the instructions in .agents/skills/pr-review/SKILL.md (and checklist.md beside it). Arguments: $range --hook. This is a non-interactive run: do not ask questions, and end your output with the REVIEW_RESULT line the skill describes."

echo "pre-push: reviewing $range with ${agent:-custom command} ..."
output_file=$(mktemp)

status=0
eval "$command \"\$prompt\"" </dev/null >"$output_file" || status=$?
cat "$output_file"

result=$(grep 'REVIEW_RESULT:' "$output_file" | tail -n 1) || true
rm -f "$output_file"

if [ $status -ne 0 ] || [ -z "$result" ]; then
  echo "pre-push: AI review did not complete, allowing push"
  exit 0
fi

case "$result" in
  *BLOCKING*)
    echo
    echo "pre-push: AI review found Blocking issues — push stopped."
    echo "Fix them, or push anyway with SKIP_PR_REVIEW=1 git push"
    exit 1
    ;;
esac

exit 0
