# Copy to .env (gitignored). Nodemon loads .env via --env-file-if-exists=.env.

# Case Management API (local dotnet run defaults — http://localhost:8085)
# CASE_MANAGEMENT_API_BASE_URL=http://localhost:8085
# CASE_MANAGEMENT_API_CLIENT_ID=frontend
# CASE_MANAGEMENT_API_SHARED_SECRET=
# CASE_MANAGEMENT_API_X_API_KEY=

# Use npm run dev:local-case-management to call a real local Case Management API (MOCK_API=false).
# Default npm run dev keeps MOCK_API=true and MSW serves case-management at the same base URL.
