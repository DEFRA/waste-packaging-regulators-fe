{
  "name": "waste-packaging-regulators-fe",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": false,
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:frontend": "cross-env NODE_ENV=production webpack",
    "dev": "run-p frontend:watch server:watch",
    "dev:debug": "run-p frontend:watch server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"**/*.{js,cjs,md,json,config.js,test.js}\"",
    "frontend:watch": "cross-env NODE_ENV=development webpack --watch",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "postinstall": "npm run setup:husky",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "pretest": "npm run build:frontend",
    "test": "cross-env TZ=UTC vitest run --coverage",
    "test:watch": "cross-env TZ=UTC vitest",
    "security-audit": "npm audit --audit-level=high",
    "server:watch": "nodemon --inspect=localhost:9230 --ext js,json --legacy-watch ./src",
    "server:debug": "nodemon --inspect-brk=localhost:9230 --ext js,json --legacy-watch ./src",
    "setup:certs": "mkdir -p certs && mkcert -install && mkcert -key-file certs/localhost-key.pem -cert-file certs/localhost-cert.pem localhost 127.0.0.1 ::1",
    "prestart": "npm run build:frontend",
    "start": "cross-env NODE_ENV=production node --use-strict .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.6.0",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/bell": "13.1.0",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.1",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/yar": "11.0.3",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "8.0.1",
    "cssnano-preset-default": "8.0.1",
    "date-fns": "4.2.1",
    "dotenv": "17.4.2",
    "global-agent": "4.1.3",
    "govuk-frontend": "6.1.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "3.0.1",
    "ioredis": "5.10.1",
    "lodash": "4.18.1",
    "node-fetch": "3.3.2",
    "nunjucks": "3.2.4",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "semver": "7.8.0",
    "undici": "8.3.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.5",
    "@vitest/coverage-v8": "4.1.7",
    "autoprefixer": "10.5.0",
    "babel-loader": "10.1.1",
    "cheerio": "1.2.0",
    "clean-webpack-plugin": "4.0.0",
    "copy-webpack-plugin": "14.0.0",
    "cross-env": "10.1.0",
    "eslint": "10.4.0",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "postcss-load-config": "6.0.1",
    "postcss-loader": "8.2.1",
    "prettier": "3.8.3",
    "sass-embedded": "1.99.0",
    "sass-loader": "17.0.0",
    "source-map-loader": "5.0.0",
    "stylelint": "17.12.0",
    "stylelint-config-gds": "2.0.0",
    "terser-webpack-plugin": "5.6.0",
    "vitest": "4.1.7",
    "vitest-fetch-mock": "0.4.5",
    "webpack": "5.107.0",
    "webpack-assets-manifest": "6.5.1",
    "webpack-cli": "7.0.2"
  },
  "overrides": {
    "tmp": "0.2.5"
  }
}
