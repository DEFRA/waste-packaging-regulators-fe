{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% set locale = params.locale | default('en') %}
{% set actionUrl = params.action | default('/') %}
{# Hand-rolled rather than the mojSearch macro: that macro cannot set the
   input value or an error message, and renders its own form with no slot
   for custom hidden inputs (params.hiddenFields) that preserve query state. #}
<div class="v3-search-panel govuk-!-margin-bottom-4">
  <search class="moj-search">
    <form action="{{ actionUrl }}" method="get" novalidate>
      {% if locale == 'cy' %}
        <input type="hidden" name="lang" value="cy">
      {% endif %}
      {% if params.hiddenFields %}
        {% for fieldName, fieldValue in params.hiddenFields %}
          {% if fieldValue != null and not (locale == 'cy' and fieldName == 'lang') %}
            <input type="hidden" name="{{ fieldName }}" value="{{ fieldValue }}">
          {% endif %}
        {% endfor %}
      {% endif %}

      {% set searchButtonHtml %}
        {{ govukButton({
          classes: "moj-search__button govuk-!-margin-bottom-0 govuk-!-margin-left-2",
          text: params.buttonText | default(t(locale, "common.search"))
        }) }}
      {% endset %}

      {{ govukInput({
        classes: "moj-search__input",
        label: {
          text: params.label,
          classes: "moj-search__label govuk-!-font-weight-bold"
        },
        id: params.id | default("search"),
        name: params.name | default("search"),
        type: "search",
        value: params.searchTerm,
        errorMessage: params.errorMessage,
        inputWrapper: {
          classes: "moj-search__input-wrapper"
        },
        formGroup: {
          afterInput: {
            html: searchButtonHtml
          }
        }
      }) }}
    </form>
  </search>
</div>
