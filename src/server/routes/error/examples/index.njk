{% extends 'layouts/page.njk' %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">Error page examples</h1>
      <p class="govuk-body">These previews are only available outside production.</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for example in examples %}
          <li>
            <a class="govuk-link" href="/error-examples/{{ example.statusCode }}">{{ example.statusCode }} — {{ example.description }}</a>
          </li>
        {% endfor %}
      </ul>
      <p class="govuk-body">To see the 503 page as a shuttered service rather than a preview, restart with <code>MAINTENANCE_MODE=true</code>.</p>
    </div>
  </div>
{% endblock %}
