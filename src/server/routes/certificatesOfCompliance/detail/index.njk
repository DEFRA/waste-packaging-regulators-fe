{% extends 'layouts/page.njk' %}
{% from "status-tag/macro.njk" import appStatusTag %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "csrf-field/macro.njk" import appCsrfField %}

{% macro materialStatusTag(status) %}
  {% switch status %}
    {% case 'met' %}
      <strong class="govuk-tag govuk-tag--green govuk-!-font-size-16">Met</strong>
    {% case 'not-met' %}
      <strong class="govuk-tag govuk-tag--red govuk-!-font-size-16">Not met</strong>
    {% case 'no-data' %}
      <strong class="govuk-tag govuk-tag--grey govuk-!-font-size-16">No data</strong>
  {% endswitch %}
{% endmacro %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {% if successBanner %}
        {{ govukNotificationBanner({
          classes: 'app-notification-banner--cancelled' if successBanner.type == 'cancelled' else '',
          titleText: successBanner.heading,
          html: '
            <p class="govuk-body govuk-!-margin-bottom-0">' ~ successBanner.text ~ '</p>
          '
        }) }}
      {% endif %}

      <span class="govuk-caption-l govuk-!-margin-bottom-2">{{ complianceTypeLabel }}</span>
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-4">{{ companyName }}</h1>

      <div class="govuk-inset-text govuk-!-margin-top-0 govuk-!-margin-bottom-6">
        <p class="govuk-body">The information on this certificate was correct at the time of submission.</p>
      </div>

      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <dl class="govuk-summary-list">
            {% if registrationType == 'ComplianceScheme' %}
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Regulation 43</dt>
                <dd class="govuk-summary-list__value">
                  {% if regulation43Met == null %}
                    No data
                  {% else %}
                    {{ appStatusTag({ value: regulation43Met, trueText: 'Compliant', falseText: 'Not compliant' }) }}
                  {% endif %}
                </dd>
              </div>
            {% endif %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Recycling obligations</dt>
              <dd class="govuk-summary-list__value">
                {% if declarationStatus == 'Unsubmitted' %}
                  <strong class="govuk-tag govuk-tag--grey govuk-!-font-size-16">Unsubmitted</strong>
                {% elif recyclingObligationsMet == null %}
                  No data
                {% else %}
                  {{ appStatusTag({ value: recyclingObligationsMet, trueText: 'Met', falseText: 'Not met' }) }}
                {% endif %}
              </dd>
            </div>
            {% if showAcceptedOutcome %}
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">{{ complianceStatusLabel }}</dt>
                <dd class="govuk-summary-list__value">
                  <strong class="govuk-tag govuk-tag--blue govuk-!-font-size-16">Accepted</strong>
                </dd>
              </div>
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Accepted by</dt>
                <dd class="govuk-summary-list__value">{{ acceptedBy }}</dd>
              </div>
              <div class="govuk-summary-list__row">
                <dt class="govuk-summary-list__key">Accepted date</dt>
                <dd class="govuk-summary-list__value">{{ acceptedDate }}</dd>
              </div>
            {% endif %}
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Submitted on</dt>
              <dd class="govuk-summary-list__value">{{ dateDeclarationSubmitted }}</dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
          <dl class="govuk-summary-list govuk-!-margin-bottom-0">
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Organisation type</dt>
              <dd class="govuk-summary-list__value">{{ organisationType }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Organisation ID</dt>
              <dd class="govuk-summary-list__value">{{ organisationRef }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Company number</dt>
              <dd class="govuk-summary-list__value">
                {{ companiesHouseNumber }}{% if companiesHouseNumber != 'No data' %}<br>
                <a href="https://find-and-update.company-information.service.gov.uk/company/{{ companiesHouseNumber }}" class="govuk-link govuk-link--no-visited-state" target="_blank" rel="noopener noreferrer">View on Companies House<span class="govuk-visually-hidden"> (opens in new tab)</span></a>{% endif %}
              </dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Name on account</dt>
              <dd class="govuk-summary-list__value">{{ nameOnAccount }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Email address</dt>
              <dd class="govuk-summary-list__value">{{ declarationEmailAddress }}</dd>
            </div>
            <div class="govuk-summary-list__row">
              <dt class="govuk-summary-list__key">Phone number</dt>
              <dd class="govuk-summary-list__value">{{ companyPhoneNumber }}</dd>
            </div>
          </dl>
        </div>
      </div>

      <hr class="govuk-section-break govuk-section-break--l">
      <hr class="govuk-section-break govuk-section-break--l">

      {% if registrationType == 'ComplianceScheme' %}
        <div data-testid="regulation-43">
          <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Regulation 43</h2>
          {% if regulation43Met == null %}
            <p class="govuk-hint">No data</p>
          {% else %}
            <p class="govuk-body">{{ regulation43Statement }}</p>
          {% endif %}
        </div>

        <hr class="govuk-section-break govuk-section-break--l">
      {% endif %}

      {% if showDeclaration %}
        <div data-testid="declaration">
          <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Declaration</h2>
          <p class="govuk-body">{{ declarationSignedBy }} signed the declaration to verify that:</p>
          <ul class="govuk-list govuk-list--bullet govuk-!-margin-bottom-0">
            <li>they are an approved or delegated person who is eligible to submit this <span data-testid="declaration-noun">{{ complianceDocumentNoun }}</span> on behalf of {{ companyName }}</li>
            <li>the information they submitted is accurate</li>
            <li>they understand that they may face enforcement action if they submit false or misleading information</li>
          </ul>
        </div>

        <hr class="govuk-section-break govuk-section-break--l">
      {% endif %}

      {% if queryDetails %}
        <h2 class="govuk-heading-m">Query details</h2>
        {{ govukSummaryList({
          rows: [
            {
              key: { text: "Queried materials" },
              value: { text: queryDetails.queriedMaterials }
            },
            {
              key: { text: "Reason" },
              value: { text: queryDetails.reason }
            },
            {
              key: { text: "Date queried" },
              value: { text: queryDetails.dateQueried }
            }
          ]
        }) }}
      {% endif %}

      {% if cancellationDetails %}
        <h2 class="govuk-heading-m">Cancellation details</h2>
        {{ govukSummaryList({
          rows: [
            {
              key: { text: "Reason" },
              value: { text: cancellationDetails.reason }
            },
            {
              key: { text: "Re-submission requested" },
              value: { text: cancellationDetails.resubmissionRequested }
            },
            {
              key: { text: "Date cancelled" },
              value: { text: cancellationDetails.dateCancelled }
            }
          ]
        }) }}
      {% endif %}

      <h2 class="govuk-heading-m">Recycling obligations</h2>
      {%  if showObligations %}
        <p class="govuk-body-m govuk-!-margin-bottom-3">All values are in tonnes.</p>

        <table class="govuk-table" data-testid="obligations-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Material</th>
              <th scope="col" class="govuk-table__header govuk-table__header--numeric">Recycling obligations to meet</th>
              <th scope="col" class="govuk-table__header govuk-table__header--numeric">Tonnage awaiting acceptance</th>
              <th scope="col" class="govuk-table__header govuk-table__header--numeric">Tonnage accepted</th>
              <th scope="col" class="govuk-table__header govuk-table__header--numeric">Tonnage outstanding</th>
              <th scope="col" class="govuk-table__header">Status</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for material in materials %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ material.name }}</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">{{ material.obligationToMeet }}</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">{{ material.awaitingAcceptance }}</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">{{ material.accepted }}</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">{{ material.outstanding }}</td>
                <td class="govuk-table__cell">
                  {{ materialStatusTag(material.status) }}
                </td>
              </tr>
            {% endfor %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell govuk-!-font-weight-bold">Totals</td>
              <td class="govuk-table__cell govuk-table__cell--numeric govuk-!-font-weight-bold">{{ materialTotals.obligationToMeet }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric govuk-!-font-weight-bold">{{ materialTotals.awaitingAcceptance }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric govuk-!-font-weight-bold">{{ materialTotals.accepted }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric govuk-!-font-weight-bold">{{ materialTotals.outstanding }}</td>
              <td class="govuk-table__cell">
                {{ materialStatusTag(materialTotals.status) }}
              </td>
            </tr>
          </tbody>
        </table>

        <h3 class="govuk-heading-s govuk-!-margin-top-8">Glass recycling obligation breakdown</h3>

        <table class="govuk-table" data-testid="glass-breakdown-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Material</th>
              <th scope="col" class="govuk-table__header govuk-table__header--numeric">Recycling obligations to meet</th>
              <th scope="col" class="govuk-table__header govuk-table__header--numeric">Tonnage awaiting acceptance</th>
              <th scope="col" class="govuk-table__header govuk-table__header--numeric">Tonnage accepted</th>
              <th scope="col" class="govuk-table__header govuk-table__header--numeric">Tonnage outstanding</th>
              <th scope="col" class="govuk-table__header">Status</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for row in glassBreakdown %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ row.name }}</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.obligationToMeet }}</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.awaitingAcceptance }}</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.accepted }}</td>
                <td class="govuk-table__cell govuk-table__cell--numeric">{{ row.outstanding }}</td>
                <td class="govuk-table__cell">
                  {{ materialStatusTag(row.status) }}
                </td>
              </tr>
            {% endfor %}
            <tr class="govuk-table__row">
              <td class="govuk-table__cell govuk-!-font-weight-bold">Totals</td>
              <td class="govuk-table__cell govuk-table__cell--numeric govuk-!-font-weight-bold">{{ glassBreakdownTotals.obligationToMeet }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric govuk-!-font-weight-bold">{{ glassBreakdownTotals.awaitingAcceptance }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric govuk-!-font-weight-bold">{{ glassBreakdownTotals.accepted }}</td>
              <td class="govuk-table__cell govuk-table__cell--numeric govuk-!-font-weight-bold">{{ glassBreakdownTotals.outstanding }}</td>
              <td class="govuk-table__cell">
                {{ materialStatusTag(glassBreakdownTotals.status) }}
              </td>
            </tr>
          </tbody>
        </table>
      {% else %}
        <p class="govuk-body-m">No data</p>
      {% endif %}
      <hr class="govuk-section-break govuk-section-break--l">

      <h2 class="govuk-heading-m">Current year</h2>
      {% if currentYearActions.length === 0 %}
        <p class="govuk-body">No previous submissions</p>
      {% else %}
        <table class="govuk-table">
          <thead class="govuk-table__head">
            <tr class="govuk-table__row">
              <th scope="col" class="govuk-table__header">Date</th>
              <th scope="col" class="govuk-table__header">Action</th>
              <th scope="col" class="govuk-table__header">By</th>
              <th scope="col" class="govuk-table__header">Reason</th>
            </tr>
          </thead>
          <tbody class="govuk-table__body">
            {% for row in currentYearActions %}
              <tr class="govuk-table__row">
                <td class="govuk-table__cell">{{ row.date }}</td>
                <td class="govuk-table__cell">
                  {% if row.action === 'Accepted' %}
                    <strong class="govuk-tag govuk-tag--blue govuk-!-font-size-16">Accepted</strong>
                  {% elif row.action === 'Cancelled' %}
                    <strong class="govuk-tag govuk-tag--grey govuk-!-font-size-16">Cancelled</strong>
                  {% endif %}
                </td>
                <td class="govuk-table__cell">{{ row.by }}</td>
                <td class="govuk-table__cell">{{ row.reason if row.reason else '' }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      {% endif %}

      <hr class="govuk-section-break govuk-section-break--l">

      {% if actions.showAccept or actions.showCancel %}
        <div class="govuk-button-group govuk-!-display-inline">
          <form method="post" action="{{ actions.urls.cancel }}">
            {{ appCsrfField(CSRFToken) }}
            {% if actions.showAccept %}
              <a href="{{ actions.urls.accept }}" role="button" draggable="false" class="govuk-button" data-module="govuk-button">
                {{ actions.labels.accept }}
              </a>
            {% endif %}
            {% if actions.showCancel %}
              <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button" data-prevent-double-click="true">
                {{ actions.labels.cancel }}
              </button>
            {% endif %}
          </form>
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endblock %}
