{% extends 'layouts/page.njk' %}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "csrf-field/macro.njk" import appCsrfField %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors %}
        {{ govukErrorSummary({
          titleText: t(locale, "common.errorSummary.title"),
          errorList: errors.summary
        }) }}
      {% endif %}

      <form method="post" action="{{ localeUrl('/' ~ organisationId ~ '/certificates-of-compliance/' ~ id ~ '/cancel/reason') }}" novalidate>
        {{ appCsrfField(CSRFToken) }}
        {{ govukRadios({
          name: "cancel-reason",
          fieldset: {
            legend: {
              text: i18n.t('reason.legend', { companyName: companyName, docTypeLower: docTypeLower }),
              isPageHeading: true,
              classes: "govuk-fieldset__legend--l"
            }
          },
          errorMessage: errors.cancelReason if errors,
          items: reasonItems
        }) }}

        {{ govukButton({
          text: t(locale, "common.continue"),
          preventDoubleClick: true
        }) }}
      </form>
    </div>
  </div>
{% endblock %}
