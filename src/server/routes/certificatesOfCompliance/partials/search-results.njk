{% from "status-tag/macro.njk" import appStatusTag %}

<div id="search-results" class="govuk-!-margin-bottom-6">
  <p class="govuk-body govuk-!-margin-bottom-4">
    {% if searchResultCount == 1 %}
      {{ i18n.t('searchResults.resultSingular', { count: searchResultCount, searchTerm: searchTerm }) }}
    {% else %}
      {{ i18n.t('searchResults.resultPlural', { count: searchResultCount, searchTerm: searchTerm }) }}
    {% endif %}
    <a href="{{ clearSearchUrl }}" class="govuk-link govuk-link--no-visited-state govuk-!-margin-left-2">{{ i18n.t('searchResults.clearSearch') }}</a>
  </p>

  {% if searchItems.length %}
    {% if searchTruncated %}
      <p class="govuk-body govuk-!-margin-bottom-4">
        {{ i18n.t('searchResults.truncated', { count: searchItems.length }) }}
      </p>
    {% endif %}

    <table class="govuk-table v3-compact-table">
      <caption class="govuk-table__caption govuk-visually-hidden">{{ i18n.t('searchResults.caption') }}</caption>
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th class="govuk-table__header govuk-!-width-one-quarter" scope="col">{{ t(locale, 'certificatesOfCompliance.common.columns.organisationName') }}</th>
          <th class="govuk-table__header" scope="col">{{ t(locale, 'certificatesOfCompliance.common.columns.organisationId') }}</th>
          <th class="govuk-table__header" scope="col">{{ t(locale, 'certificatesOfCompliance.common.columns.submissionStatus') }}</th>
          <th class="govuk-table__header" scope="col">{{ t(locale, 'certificatesOfCompliance.common.columns.recyclingObligations') }}</th>
          {% if organisationType == 'compliance-schemes' %}
            <th class="govuk-table__header" scope="col">{{ t(locale, 'certificatesOfCompliance.common.columns.regulation43') }}</th>
          {% else %}
            <th class="govuk-table__header" scope="col">{{ t(locale, 'certificatesOfCompliance.common.columns.percentageMet') }}</th>
          {% endif %}
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for item in searchItems %}
          <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header govuk-!-width-one-quarter">
              <a href="{{ localeUrl('./' ~ item.organisationId ~ '/certificates-of-compliance/' ~ item.id) }}" class="govuk-link govuk-link--no-visited-state">{{ item.organisationName }}</a>
            </th>
            <td class="govuk-table__cell">{{ item.organisationReferenceNumber }}</td>
            <td class="govuk-table__cell">
              {% if item.submissionStatus == 'Accepted' %}
                <strong class="govuk-tag govuk-tag--teal">{{ t(locale, 'certificatesOfCompliance.common.submissionStatus.accepted') }}</strong>
              {% elif item.submissionStatus == 'Cancelled' %}
                <strong class="govuk-tag govuk-tag--grey">{{ t(locale, 'certificatesOfCompliance.common.submissionStatus.cancelled') }}</strong>
              {% else %}
                <strong class="govuk-tag govuk-tag--blue">{{ item.submissionStatus }}</strong>
              {% endif %}
            </td>
            <td class="govuk-table__cell">
              {{ appStatusTag({ value: item.recyclingObligationsMet, trueText: i18n.ct('statusTag', 'met'), falseText: i18n.ct('statusTag', 'notMet'), locale: locale, i18n: i18n }) }}
            </td>
            {% if organisationType == 'compliance-schemes' %}
              <td class="govuk-table__cell">
                {{ appStatusTag({ value: item.regulation43Met, trueText: i18n.ct('statusTag', 'compliant'), falseText: i18n.ct('statusTag', 'notCompliant'), locale: locale, i18n: i18n }) }}
              </td>
            {% else %}
              <td class="govuk-table__cell">{% if item.obligationCoveragePercentage != null %}{{ item.obligationCoveragePercentage }}%{% else %}—{% endif %}</td>
            {% endif %}
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p class="govuk-body">{{ i18n.t('searchResults.noResults') }}</p>
  {% endif %}
</div>
