{% from "status-tag/macro.njk" import appStatusTag %}

<div class="govuk-tabs__panel" id="{{ activeTab }}">
  <p class="govuk-body-l govuk-!-margin-bottom-4">
    <strong>{{ tabCount }}</strong> {{ tabSummaryText }}
  </p>

  <a href="#todo" role="button" draggable="false" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-4" data-module="govuk-button">
    Download list (CSV)
  </a>

  <table class="govuk-table v3-compact-table">
    <caption class="govuk-table__caption govuk-visually-hidden">{{ tabSummaryText | capitalize }}</caption>
    <thead class="govuk-table__head">
      <tr class="govuk-table__row">
        <th class="govuk-table__header govuk-!-width-one-quarter" scope="col">Organisation name</th>
        <th class="govuk-table__header" scope="col">Organisation ID</th>
        <th class="govuk-table__header" scope="col">Recycling obligations</th>
        {% if organisationType == 'compliance-schemes' %}
          <th class="govuk-table__header" scope="col">Regulation 43</th>
        {% endif %}
        <th class="govuk-table__header" scope="col">Percentage met</th>
        {% if activeTab != 'not-submitted' %}
          <th class="govuk-table__header" scope="col">Date submitted</th>
        {% endif %}
      </tr>
    </thead>
    <tbody class="govuk-table__body">
      {% for item in items %}
        <tr class="govuk-table__row">
          {% if item.id == null %}
            <td class="govuk-table__cell">
              <a href="./{{ item.organisationId }}/certificates-of-compliance?obligationYear={{ complianceYear }}" class="govuk-link govuk-link--no-visited-state">{{ item.organisationName }}</a>
            </td>
          {% else %}
            <td class="govuk-table__cell">
              <a href="./{{ item.organisationId }}/certificates-of-compliance/{{ item.id }}" class="govuk-link govuk-link--no-visited-state">{{ item.organisationName }}</a>
            </td>
          {% endif %}

          <td class="govuk-table__cell">{{ item.organisationReferenceNumber }}</td>
          <td class="govuk-table__cell">
            {{ appStatusTag({ value: item.recyclingObligationsMet, trueText: 'Met', falseText: 'Not met' }) }}
          </td>
          {% if organisationType == 'compliance-schemes' %}
            <td class="govuk-table__cell">
              {{ appStatusTag({ value: item.regulation43Met, trueText: 'Compliant', falseText: 'Not compliant' }) }}
            </td>
          {% endif %}
          <td class="govuk-table__cell">{% if item.obligationCoveragePercentage !== null %}{{ item.obligationCoveragePercentage }}%{% else %}—{% endif %}</td>
          {% if activeTab != 'not-submitted' %}
            <td class="govuk-table__cell">{{ item.dateSubmitted | formatDate('do MMMM yyyy') }}</td>
          {% endif %}
        </tr>
      {% endfor %}
    </tbody>
  </table>

  {% include "pagination/template.njk" %}
</div>
