{% extends 'layouts/page.njk' %}

{% from "search/macro.njk" import appSearch %}
{% from "producer-subnavigation/macro.njk" import appProducerSubnavigation %}
{% from "tabs-list/macro.njk" import appTabsList %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <span class="govuk-caption-l">{{ i18n.t('relevantYearCaption', { complianceYear: complianceYear }) }}</span>
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-6">{{ heading }}</h1>
    </div>
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors %}
        {{ govukErrorSummary({
          titleText: t(locale, "common.errorSummary.title"),
          errorList: errors.summary
        }) }}
      {% endif %}

      {{ appSearch({
        action: localeUrl(routePrefix or '/'),
        locale: locale,
        hiddenFields: {
          type: organisationType,
          tab: activeTab,
          sort: sort.column ~ '[' ~ sort.direction ~ ']'
        },
        label: i18n.t('search.label'),
        searchTerm: searchTerm,
        errorMessage: errors.search if errors
      }) }}
    </div>
  </div>
  {% if isSearch %}
    {% include "certificatesOfCompliance/partials/search-results.njk" %}
  {% endif %}

  {{ appProducerSubnavigation({
    ariaLabel: t(locale, 'certificatesOfCompliance.common.producerTypeNav.ariaLabel'),
    items: [
      {
        text: t(locale, 'certificatesOfCompliance.common.producerTypeNav.directProducers'),
        href: localeUrl((routePrefix or '/') ~ '?type=direct-producers&tab=' ~ activeTab),
        current: organisationType == 'direct-producers'
      },
      {
        text: t(locale, 'certificatesOfCompliance.common.producerTypeNav.complianceSchemes'),
        href: localeUrl((routePrefix or '/') ~ '?type=compliance-schemes&tab=' ~ activeTab),
        current: organisationType == 'compliance-schemes'
      }
    ]
  }) }}

  <div class="govuk-tabs">
    {{ appTabsList({
      items: [
        {
          text: tabLabels.pending,
          href: localeUrl('?type=' ~ organisationType ~ '&tab=pending&clearSort=true'),
          current: activeTab == 'pending'
        },
        {
          text: tabLabels.accepted,
          href: localeUrl('?type=' ~ organisationType ~ '&tab=accepted&clearSort=true'),
          current: activeTab == 'accepted'
        },
        {
          text: tabLabels.notSubmitted,
          href: localeUrl('?type=' ~ organisationType ~ '&tab=not-submitted&clearSort=true'),
          current: activeTab == 'not-submitted'
        }
      ]
    }) }}
    {% if activeTab == 'pending' %}
      {% set tabCount = totalPending %}
      {% set tabSummaryText = i18n.t('tabSummary.pending') %}
    {% elif activeTab == 'accepted' %}
      {% set tabCount = totalAccepted %}
      {% set tabSummaryText = i18n.t('tabSummary.accepted') %}
    {% elif activeTab == 'not-submitted' %}
      {% set tabCount = totalNotSubmitted %}
      {% set tabSummaryText = i18n.t('tabSummary.notSubmitted') %}
    {% endif %}
    {% include "certificatesOfCompliance/partials/tab-panel.njk" %}
  </div>
{% endblock %}
