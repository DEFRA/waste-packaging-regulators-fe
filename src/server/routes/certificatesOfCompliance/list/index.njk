{% extends 'layouts/page.njk' %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <span class="govuk-caption-l">{{ i18n.t('relevantYearCaption', { complianceYear: complianceYear }) }}</span>
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-6">{{ heading }}</h1>
    </div>
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors %}
        {{ govukErrorSummary({
          titleText: t(locale, "common.errorSummary.title"),
          errorList: errors.summary
        }) }}
      {% endif %}

      {# Hand-rolled rather than the mojSearch macro: that macro cannot set the
         input value or an error message, and renders its own form with no slot
         for the hidden inputs that keep the user on the same type and tab. #}
      <div class="v3-search-panel govuk-!-margin-bottom-4">
        <div class="moj-search">
          <form action="{{ localeUrl('/certificates-of-compliance', locale) }}" method="get" novalidate>
            <input type="hidden" name="type" value="{{ organisationType }}">
            <input type="hidden" name="tab" value="{{ activeTab }}">
            <input type="hidden" name="sort" value="{{ sort.column }}[{{ sort.direction }}]">

            {{ govukInput({
              classes: "moj-search__input",
              label: {
                text: i18n.t('search.label'),
                classes: "moj-search__label govuk-!-font-weight-bold"
              },
              id: "search",
              name: "search",
              type: "search",
              value: searchTerm,
              errorMessage: errors.search if errors
            }) }}

            {{ govukButton({
              classes: "moj-search__button govuk-!-margin-bottom-0",
              text: t(locale, "common.search")
            }) }}
          </form>
        </div>
      </div>
    </div>
  </div>
  {% if isSearch %}
    {% include "certificatesOfCompliance/partials/search-results.njk" %}
  {% endif %}

  {% include "certificatesOfCompliance/partials/producer-subnavigation.njk" %}
  <div class="govuk-tabs">
    <ul class="govuk-tabs__list">
      <li class="govuk-tabs__list-item{% if activeTab == 'pending' %} govuk-tabs__list-item--selected{% endif %}">
        <a class="govuk-tabs__tab" href="{{ localeUrl('?type=' ~ organisationType ~ '&tab=pending', locale) }}" {% if activeTab == 'pending' %} aria-current="page" {% endif %}>
          {{ tabLabels.pending }}
        </a>
      </li>
      <li class="govuk-tabs__list-item{% if activeTab == 'accepted' %} govuk-tabs__list-item--selected{% endif %}">
        <a class="govuk-tabs__tab" href="{{ localeUrl('?type=' ~ organisationType ~ '&tab=accepted', locale) }}" {% if activeTab == 'accepted' %} aria-current="page" {% endif %}>
          {{ tabLabels.accepted }}
        </a>
      </li>
      <li class="govuk-tabs__list-item{% if activeTab == 'not-submitted' %} govuk-tabs__list-item--selected{% endif %}">
        <a class="govuk-tabs__tab" href="{{ localeUrl('?type=' ~ organisationType ~ '&tab=not-submitted', locale) }}" {% if activeTab == 'not-submitted' %} aria-current="page" {% endif %}>
          {{ tabLabels.notSubmitted }}
        </a>
      </li>
    </ul>
    {% if activeTab == 'pending' %}
      {% set tabCount = totalPending %}
      {% set tabSummaryText = i18n.t('tabSummary.pending') %}
    {% elif activeTab == 'accepted' %}
      {% set tabCount = totalAccepted %}
      {% set tabSummaryText = i18n.t('tabSummary.accepted') %}
    {% elif activeTab == 'not-submitted' %}
      {% set tabCount = totalNotSubmitted %}
      {% set tabSummaryText = i18n.t('tabSummary.notSubmitted') %}
    {% endif %}
    {% include "certificatesOfCompliance/partials/tab-panel.njk" %}
  </div>
{% endblock %}
