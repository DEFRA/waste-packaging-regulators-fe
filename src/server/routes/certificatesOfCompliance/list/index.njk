{% extends 'layouts/page.njk' %}

{% from "search/macro.njk" import appSearch %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      <span class="govuk-caption-l">{{ i18n.t('relevantYearCaption', { complianceYear: complianceYear }) }}</span>
      <h1 class="govuk-heading-xl govuk-!-margin-bottom-6">{{ heading }}</h1>
    </div>
  </div>
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      {% if errors %}
        {{ govukErrorSummary({
          titleText: t(locale, "common.errorSummary.title"),
          errorList: errors.summary
        }) }}
      {% endif %}

      {{ appSearch({
        action: localeUrl(routePrefix or '/'),
        locale: locale,
        hiddenFields: {
          type: organisationType,
          tab: activeTab,
          sort: sort.column ~ '[' ~ sort.direction ~ ']'
        },
        label: i18n.t('search.label'),
        searchTerm: searchTerm,
        errorMessage: errors.search if errors
      }) }}
    </div>
  </div>
  {% if isSearch %}
    {% include "certificatesOfCompliance/partials/search-results.njk" %}
  {% endif %}

  {% include "certificatesOfCompliance/partials/producer-subnavigation.njk" %}
  {{ govukButton({
    text: i18n.t('downloadReport'),
    href: localeUrl(routePrefix ~ '/download?organisation_type=' ~ organisationType),
    classes: "govuk-button--secondary",
    attributes: { "data-testid": "download-report" }
  }) }}
  <div class="govuk-tabs">
    <ul class="govuk-tabs__list">
      <li class="govuk-tabs__list-item{% if activeTab == 'pending' %} govuk-tabs__list-item--selected{% endif %}">
        <a class="govuk-tabs__tab" href="{{ localeUrl('?type=' ~ organisationType ~ '&tab=pending&clearSort=true') }}" {% if activeTab == 'pending' %} aria-current="page" {% endif %}>
          {{ tabLabels.pending }}
        </a>
      </li>
      <li class="govuk-tabs__list-item{% if activeTab == 'accepted' %} govuk-tabs__list-item--selected{% endif %}">
        <a class="govuk-tabs__tab" href="{{ localeUrl('?type=' ~ organisationType ~ '&tab=accepted&clearSort=true') }}" {% if activeTab == 'accepted' %} aria-current="page" {% endif %}>
          {{ tabLabels.accepted }}
        </a>
      </li>
      <li class="govuk-tabs__list-item{% if activeTab == 'not-submitted' %} govuk-tabs__list-item--selected{% endif %}">
        <a class="govuk-tabs__tab" href="{{ localeUrl('?type=' ~ organisationType ~ '&tab=not-submitted&clearSort=true') }}" {% if activeTab == 'not-submitted' %} aria-current="page" {% endif %}>
          {{ tabLabels.notSubmitted }}
        </a>
      </li>
    </ul>
    {% if activeTab == 'pending' %}
      {% set tabCount = totalPending %}
      {% set tabSummaryText = i18n.t('tabSummary.pending') %}
    {% elif activeTab == 'accepted' %}
      {% set tabCount = totalAccepted %}
      {% set tabSummaryText = i18n.t('tabSummary.accepted') %}
    {% elif activeTab == 'not-submitted' %}
      {% set tabCount = totalNotSubmitted %}
      {% set tabSummaryText = i18n.t('tabSummary.notSubmitted') %}
    {% endif %}
    {% include "certificatesOfCompliance/partials/tab-panel.njk" %}
  </div>
{% endblock %}
